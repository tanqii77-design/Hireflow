# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 本地环境变量（含密钥）不提交
.env*
# 但 .env.example 要提交，供别人参考
!.env.example

# 本地 SQLite 数据库文件
*.db
*.db-journal
*.db-wal

# Drizzle 迁移文件（本地生成，别人通过 drizzle-kit generate 自己生成）
/drizzle

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
